<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Connection Status (Cloud & Robot) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp"
            android:paddingStart="4dp"
            android:weightSum="2">

            <!-- Cloud Connection (Top Left) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical|start">
                <View
                    android:id="@+id/cloudIndicator"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/status_dot"
                    android:backgroundTint="#F44336" />
                <TextView
                    android:id="@+id/txtCloudStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CLOUD OFFLINE"
                    android:textColor="#F44336"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Robot Connection (Top Right) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical|end"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/txtRobotStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ROBOT OFFLINE"
                    android:textColor="#F44336"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Moved the indicator AFTER the text and changed marginEnd to marginStart -->
                <View
                    android:id="@+id/robotIndicator"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/status_dot"
                    android:backgroundTint="#F44336" />
            </LinearLayout>
        </LinearLayout>

        <!-- Stream & Location WebViews -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <WebView
                android:id="@+id/streamWebView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1.2"
                android:background="#000000" />

            <WebView
                android:id="@+id/mapWebView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="0.8"
                android:background="#1E1E1E" />
        </LinearLayout>

        <!-- Telemetry HUD Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="8dp"
            app:strokeColor="#333333"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:weightSum="2">
                    <TextView android:id="@+id/txtBattery" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🔋 Battery: -- %" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/txtWaterLevel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="💧 Tank: -- %" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:weightSum="2" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/txtHumidity" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="☁️ Humid: -- % RH" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/txtTemp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🌡 Temp: -- °C" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- New Action Buttons (Call Robot & E-STOP) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallRobot"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                app:cornerRadius="6dp"
                android:backgroundTint="#FF9800"
                android:text="CALL TO MY LOCATION"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEStop"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                app:cornerRadius="6dp"
                android:backgroundTint="#D32F2F"
                android:text="E-STOP (LOCK)"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="2dp"/>
        </LinearLayout>

        <!-- Main Controller Body (Wrapped in ID for locking) -->
        <LinearLayout
            android:id="@+id/controllerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="#18181D">

            <!-- Rover Chassis -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rover Chassis" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:weightSum="3">
                <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:weightSum="5" android:gravity="center">
                    <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnFwd" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:padding="0dp" app:cornerRadius="8dp" android:insetTop="0dp" android:insetBottom="0dp" android:backgroundTint="#424242" android:text="FWD" android:textColor="#FFF" android:textStyle="bold" android:textSize="13sp"/>
                    <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:weightSum="5" android:gravity="center">
                    <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnLeft" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:padding="0dp" app:cornerRadius="8dp" android:insetTop="0dp" android:insetBottom="0dp" android:backgroundTint="#424242" android:text="LEFT" android:textColor="#FFF" android:textStyle="bold" android:textSize="13sp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnStop" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:padding="0dp" app:cornerRadius="8dp" android:insetTop="0dp" android:insetBottom="0dp" android:backgroundTint="#FF3300" android:text="STOP" android:textColor="#FFF" android:textStyle="bold" android:textSize="13sp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnRight" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:padding="0dp" app:cornerRadius="8dp" android:insetTop="0dp" android:insetBottom="0dp" android:backgroundTint="#424242" android:text="RIGHT" android:textColor="#FFF" android:textStyle="bold" android:textSize="13sp"/>
                    <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:weightSum="5" android:gravity="center">
                    <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnRev" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:padding="0dp" app:cornerRadius="8dp" android:insetTop="0dp" android:insetBottom="0dp" android:backgroundTint="#424242" android:text="REV" android:textColor="#FFF" android:textStyle="bold" android:textSize="13sp"/>
                    <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Arm and Base Controls -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginTop="8dp" android:layout_marginBottom="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingEnd="16dp" android:paddingStart="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Arm (NEMA17)" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="2dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnArmUp" android:layout_width="match_parent" android:layout_height="42dp" android:layout_margin="2dp" android:padding="0dp" app:cornerRadius="6dp" android:insetTop="0dp" android:insetBottom="0dp" android:backgroundTint="#424242" android:text="UP" android:textColor="#FFF" android:textStyle="bold" android:textSize="12sp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnArmDown" android:layout_width="match_parent" android:layout_height="42dp" android:layout_margin="2dp" android:padding="0dp" app:cornerRadius="6dp" android:insetTop="0dp" android:insetBottom="0dp" android:backgroundTint="#424242" android:text="DOWN" android:textColor="#FFF" android:textStyle="bold" android:textSize="12sp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Base (28BYJ)" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="2dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnBaseL" android:layout_width="match_parent" android:layout_height="42dp" android:layout_margin="2dp" android:padding="0dp" app:cornerRadius="6dp" android:insetTop="0dp" android:insetBottom="0dp" android:backgroundTint="#424242" android:text="ROT L" android:textColor="#FFF" android:textStyle="bold" android:textSize="12sp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnBaseR" android:layout_width="match_parent" android:layout_height="42dp" android:layout_margin="2dp" android:padding="0dp" app:cornerRadius="6dp" android:insetTop="0dp" android:insetBottom="0dp" android:backgroundTint="#424242" android:text="ROT R" android:textColor="#FFF" android:textStyle="bold" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Nozzle & Pump -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nozzle &amp; Pump" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:weightSum="3">
                <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:weightSum="5" android:gravity="center">
                    <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnNozzleUp" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:padding="0dp" app:cornerRadius="8dp" android:insetTop="0dp" android:insetBottom="0dp" android:backgroundTint="#424242" android:text="UP" android:textColor="#FFF" android:textStyle="bold" android:textSize="13sp"/>
                    <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:weightSum="5" android:gravity="center">
                    <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnNozzlePanL" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:padding="0dp" app:cornerRadius="8dp" android:insetTop="0dp" android:insetBottom="0dp" android:backgroundTint="#424242" android:text="PAN L" android:textColor="#FFF" android:textStyle="bold" android:textSize="12sp"/>

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnPumpToggle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:padding="0dp" app:cornerRadius="8dp" android:insetTop="0dp" android:insetBottom="0dp" android:backgroundTint="#00e1ff" android:text="PUMP" android:textColor="#000000" android:textStyle="bold" android:textSize="12sp"/>

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnNozzlePanR" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:padding="0dp" app:cornerRadius="8dp" android:insetTop="0dp" android:insetBottom="0dp" android:backgroundTint="#424242" android:text="PAN R" android:textColor="#FFF" android:textStyle="bold" android:textSize="12sp"/>
                    <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:weightSum="5" android:gravity="center">
                    <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnNozzleDown" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:padding="0dp" app:cornerRadius="8dp" android:insetTop="0dp" android:insetBottom="0dp" android:backgroundTint="#424242" android:text="DOWN" android:textColor="#FFF" android:textStyle="bold" android:textSize="12sp"/>
                    <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>